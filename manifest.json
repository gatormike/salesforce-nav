{
  "manifest_version": 3,
  "name": "SetupPilot for Salesforce",
  "version": "2.0.2",
  "description": "A customisable quick-navigation toolbar for Salesforce Setup \u2014 pin your favourite pages, browse history, and jump anywhere in Setup in one click.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.my.salesforce-setup.com/*"
      ],
      "js": [
        "src/constants.js",
        "src/utils.js",
        "src/storage.js",
        "config.js",
        "src/menu.js",
        "src/settings.js",
        "src/star.js",
        "src/history.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}